# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Storage Configuration
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=vector_database

# Firebase Configuration (only needed if USE_LOCAL_STORAGE=false)
FIREBASE_KEY_PATH=firebase-key.json

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
# Alternatives: text-embedding-ada-002, sentence-transformers/all-MiniLM-L6-v2

LLM_MODEL=gpt-3.5-turbo
# Alternatives: gpt-4, gpt-4-turbo-preview

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Application Configuration
APP_TITLE=RAG Investment Analysis System
APP_DESCRIPTION=Stock Market & Investment Analysis using RAG
